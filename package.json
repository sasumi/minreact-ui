{
    "name": "@sasumi/minuui",
    "private": false,
    "version": "0.0.3",
    "type": "module",
    "main": "./dist/minuui.umd.cjs",
    "module": "./dist/minuui.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/minuui.js",
            "require": "./dist/minuui.umd.cjs"
        },
        "./dist/minuui.css": "./dist/minuui.css"
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "**/*.scss",
        "**/*.css"
    ],
    "scripts": {
        "dev": "vite demo --config vite.config.ts",
        "build": "tsc && vite build && tsc -p tsconfig.build.json",
        "prebuild": "npm run generate:index",
        "prepublishOnly": "npm run build",
        "generate:index": "node scripts/generate-index.js",
        "lint": "eslint .",
        "preview": "vite preview"
    },
    "dependencies": {
        "@radix-ui/react-popover": "^1.1.23",
        "i18next": "^26.3.6",
        "minutool": "^1.0.21",
        "react-i18next": "^17.0.11",
        "react-toastify": "^11.1.0",
        "sass-embedded": "^1.100.0"
    },
    "peerDependencies": {
        "react": ">=19.0.0",
        "react-dom": ">=19.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.0.3",
        "eslint": "^10.6.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.7.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.62.0",
        "vite": "^8.1.1"
    }
}
