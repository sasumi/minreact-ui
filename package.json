{
    "name": "minreact-ui",
    "private": false,
    "version": "0.0.18",
    "type": "module",
    "main": "./dist/minreactui.umd.cjs",
    "module": "./dist/minreactui.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/minreactui.js",
            "require": "./dist/minreactui.umd.cjs"
        },
        "./dist/minreact-ui.css": "./dist/minreact-ui.css"
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "**/*.scss",
        "**/*.css"
    ],
    "scripts": {
        "dev": "vite demo --config vite.config.ts",
        "build": "tsc && vite build && tsc -p tsconfig.build.json && node scripts/copy-assets.js",
        "prebuild": "npm run generate:index",
        "prepublishOnly": "npm run build",
        "generate:index": "node scripts/generate-index.js",
        "lint": "eslint .",
        "preview": "vite preview"
    },
    "dependencies": {
        "@radix-ui/react-popover": "^1.1.23",
        "i18next": "^26.4.0",
        "minutool": "^1.0.26",
        "react-i18next": "^17.0.12",
        "react-toastify": "^11.1.0",
        "sass-embedded": "^1.103.1"
    },
    "peerDependencies": {
        "react": ">=19.0.0",
        "react-dom": ">=19.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.1.0",
        "eslint": "^10.9.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.4",
        "globals": "^17.11.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.2.2"
    }
}
